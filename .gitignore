# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file and bundle for alternative installation
vendor/
.bundle/

# Local environment (machine-specific paths; never commit)
.env
.env.local

# Draft build artifacts (e.g. CV draft PDFs from scripts/cv2tex.py)
build/

# Python bytecode cache
__pycache__/

# macOS
.DS_Store

# Local preview override (bundle exec jekyll serve --config _config.yml,_config.local.yml)
_config.local.yml
